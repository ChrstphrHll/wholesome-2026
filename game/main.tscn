[connection signal="pressed" from="debug/HBoxContainer/Button2" to="." method="_move_screen" binds= [1]]
[connection signal="pressed" from="debug/HBoxContainer/Button3" to="." method="_move_screen" binds= [2]]
[connection signal="pressed" from="debug/HBoxContainer/Button4" to="." method="_move_screen" binds= [3]]
[connection signal="pressed" from="Menu/Button" to="." method="_move_screen" binds= [1]]
[connection signal="pressed" from="Desk/NextClient" to="." method="call_next_client"]
[connection signal="pressed" from="PhotoWall/Panel/MarginContainer/VBoxContainer2/ScrollContainer/Backdrops/Beach" to="." method="_on_beach_pressed"]
[connection signal="pressed" from="PhotoWall/Panel/MarginContainer/VBoxContainer2/ScrollContainer/Backdrops/Space" to="." method="_on_space_pressed"]
[connection signal="pressed" from="PhotoWall/Panel/MarginContainer/VBoxContainer2/ChangeOutfit" to="." method="_on_change_outfit_pressed"]
[connection signal="pressed" from="PhotoWall/Panel/MarginContainer/VBoxContainer2/TakePhoto" to="." method="_on_take_photo_pressed"]
[connection signal="pressed" from="DressUp/Done" to="." method="_on_dress_up_finished"]
