; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="wholesome-2026"
run/main_scene="uid://d1j0rr77xt3v7"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneManager="*uid://dgqo8e2v2phlc"
DialogueManager="*uid://c3rodes2l3gxb"

[dialogue_manager]

runtime/balloon_path="res://dialog/dress_up_bubble/dress_up_balloon.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[gui]

theme/custom="uid://0i84hkem3flu"

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialog/test_dialog.dialogue", "res://dialog/generic_horse.dialogue", "res://dialog/lost_my_job.dialogue", "res://athlete.dialogue", "res://dialog/influencer.dialogue", "res://dialog/gamer.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
